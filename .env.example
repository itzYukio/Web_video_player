PORT=3000
HOST=0.0.0.0

# Mounted VPS media directory.
MEDIA_ROOT=/media

# Persistent application data. Mount a Coolify volume here.
DATA_ROOT=/data

# Required for authentication, sessions, progress and other state.
REDIS_URL=redis://redis:6379

# First administrator. Used only when the SQLite database has no users.
# Change these before first deployment.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-long-random-password

# Session lifetime in seconds. 30 days.
SESSION_TTL=2592000

# Comma-separated video extensions.
VIDEO_EXTENSIONS=mp4,mkv,webm,m4v,mov,avi,ts,mts,m2ts

# Maximum thumbnail width.
THUMB_WIDTH=640
