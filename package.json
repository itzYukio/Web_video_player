    "ioredis": "^5.6.1",
    "mime-types": "^3.0.1",
    "tsx": "^4.20.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^24.0.15",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
